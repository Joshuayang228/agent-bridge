# Agent Bridge 配置示例
# 复制为 .env 并填入实际值（.env 已在 .gitignore 中，不会被提交）

# === 家里 Gateway 模式（start.bat）===
# 云端 relay 的 WS URL，配置后家里 Gateway 会主动连云端
# RELAY_URL=ws://your-vps.example.com:18790/agent
# 连 relay 的鉴权 token，需与云端 RELAY_TOKEN 一致
# AGENT_TOKEN=your-secret-agent-token
# Gateway 标识，默认 hostname-随机
# AGENT_ID=my-home-gateway

# === 云端 Relay 模式（npm run start:relay）===
# relay 鉴权 token，家里 Gateway 的 AGENT_TOKEN 必须与此一致
# RELAY_TOKEN=your-secret-agent-token
# relay 监听端口，默认 18790
# RELAY_PORT=18790
# relay 公网 URL（用于生成扫码配对 URL，Caddy 反代 wss 后填 https://your-domain）
# RELAY_PUBLIC_URL=https://relay.example.com
